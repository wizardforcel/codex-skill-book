# 通义听悟转写所需密钥。
# 复制本文件为 ~/.codex/meeting-minutes.env 并填入你自己的值。
# ⚠️ 切勿把填好真实值的文件提交到 git。

# 阿里云 AccessKey（用于 OSS 上传 + 通义听悟调用）
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret

# 通义听悟应用 AppKey
TINGWU_APPKEY=your_tingwu_appkey

# OSS 配置（音频临时上传到这里，转写完成后自动删除）
OSS_BUCKET=your_bucket_name
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing

# 可选：默认 tingwu.<OSS_REGION>.aliyuncs.com；北京地域用下面这个
# TINGWU_ENDPOINT=tingwu.cn-beijing.aliyuncs.com
